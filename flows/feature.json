{
  "name": "feature",
  "description": "Spec, approve, plan, build, review and QA one feature; code decides the verdict",
  "inputs": { "topic": "text" },
  "steps": [
    { "id": "spec", "run": "uvs-spec", "with": { "topic": "inputs.topic", "findings": "steps.review.outputs.findings?" } },
    { "id": "signoff", "gate": "Approve the spec?", "show": "steps.spec.outputs.spec",
      "routes": { "approve": "plan", "reject": "spec" }, "max_loops": 3 },
    { "id": "plan", "run": "uvs-architect", "with": { "spec": "steps.spec.outputs.spec" } },
    { "id": "build", "run": "uvs-prototype", "with": { "plan": "steps.plan.outputs.plan" } },
    { "id": "checks", "parallel": [
        { "id": "review", "decide": "uvs-review", "with": { "diff": "workspace.diff" } },
        { "id": "qa", "decide": "uvs-qa", "with": { "diff": "workspace.diff" } } ] },
    { "id": "verdict", "exec": "scripts/verdict.py", "effects": "read-only",
      "with": { "review": "steps.review.outputs.verdict", "qa": "steps.qa.outputs.verdict" },
      "routes": { "ship": "end", "revise": "build", "stop": "fail" }, "default": "stop", "max_loops": 3 }
  ]
}
